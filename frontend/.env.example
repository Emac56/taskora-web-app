# Copy this file to .env for local development.
# Not used in production — Vercel's dashboard env var overrides this at
# build time. Editing this file has no effect on the live deployed site.

# Base URL of the Spring Boot API. Falls back to this same value in code
# (see src/api/http.js) if no env var is set, so you only need to change
# this if your local backend runs on a different host/port.
VITE_API_BASE_URL=http://localhost:8080/api/v1
