# Copy this file to .env for local development.
# Not used in production — Render's dashboard env vars override all of this
# at deploy time. Editing this file has no effect on the live app.

# Supabase Postgres connection.
# Get this from: Supabase dashboard → Project Settings → Database →
# Connection string → JDBC tab (must start with jdbc:postgresql://)
SUPABASE_DB_URL=jdbc:postgresql://<host>:<port>/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Active Spring profile. Keep this "dev" for local work — it enables SQL
# logging and relaxed cookie settings (see application-dev.properties).
# Render production uses "prod" instead, set separately in its own
# dashboard — do not change this default just to test something locally.
SPRING_PROFILES_ACTIVE=dev

# Supabase project base URL and service role key.
# Get these from: Supabase dashboard → Project Settings → API
# SUPABASE_URL looks like https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is a secret — never commit it or expose it to
# the frontend, it bypasses Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only needed if you're testing the "prod" profile locally.
# Not required for normal local dev; application.properties already
# defaults to http://localhost:5173 for CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
